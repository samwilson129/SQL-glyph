  "cases": [
    {
      "id": "postgres-to-bigquery-date-trunc",
      "source": "postgres",
      "target": "bigquery",
      "sql": "SELECT customer_id, DATE_TRUNC('month', order_date) AS order_month, COUNT(*) AS total_orders FROM orders WHERE order_date >= CURRENT_DATE - INTERVAL '6 months' GROUP BY 1, 2 ORDER BY 2 DESC;",
      "status": "warning",
      "convertedContains": ["TIMESTAMP_TRUNC(order_date, MONTH)", "INTERVAL '6' MONTH", "GROUP BY", "ORDER BY", "NULLS FIRST"],
      "convertedNotContains": ["DATE_TRUNC('month'"],
      "diagnosticCategories": ["date_time", "null_handling"],
      "transformationCategories": ["date_time", "null_handling"],
      "ruleIds": ["date-trunc-bigquery-argument-order", "interval-representation", "null-ordering"]
    },
